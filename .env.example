# GEMINI_API_KEY: Required for Gemini AI API calls (Free-tier key only under FREE AI ONLY policy).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOW_APPROVED_PAID_AI: Defense-in-depth server billing lock (MUST stay "false" for FREE AI ONLY policy).
# Paid Gemini models remain technically blocked unless the owner gives explicit written permission AND sets this to "true".
ALLOW_APPROVED_PAID_AI="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUSTED CORS ORIGINS (Comma-separated list of additional allowed browser origins for /api/*)
ALLOWED_ORIGINS="https://mystudyzone.in,https://www.mystudyzone.in"

# RAZORPAY LIVE INTEGRATION
# Configure these in your deployment environment variables for Live Razorpay Payments:
# RAZORPAY_KEY_ID: Your Razorpay Key ID (rzp_live_... for production, or rzp_test_... for sandbox)
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
VITE_RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"

# RAZORPAY_KEY_SECRET: Your Razorpay Key Secret (kept strictly server-side, never exposed to browser)
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# RAZORPAYX PAYOUTS LIVE INTEGRATION (For Real-Money Referral Wallet Withdrawals)
# Configure these once RazorpayX Payouts is activated on your Razorpay account:
RAZORPAYX_KEY_ID="rzp_live_YOUR_RAZORPAYX_KEY_ID"
RAZORPAYX_KEY_SECRET="YOUR_RAZORPAYX_KEY_SECRET"
RAZORPAYX_ACCOUNT_NUMBER="YOUR_RAZORPAYX_ACCOUNT_NUMBER"
RAZORPAYX_WEBHOOK_SECRET="YOUR_RAZORPAYX_WEBHOOK_SECRET"

# FIREBASE ADMIN SDK (Required server-side for Razorpay Webhooks, QR activation & Admin APIs)
# Option 1 (Recommended for Netlify / Cloud Run / VPS): Single-line or Base64 Service Account JSON
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"gen-lang-client-0860728359","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"}'
# Option 2: Individual Firebase Service Account fields
# FIREBASE_PROJECT_ID="gen-lang-client-0860728359"
# FIREBASE_CLIENT_EMAIL="YOUR_SERVICE_ACCOUNT_EMAIL"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Option 3: Path to local Service Account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

