rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ronakvarade2022@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Verifies ownership for both UID-keyed and legacy firebaseUid-linked student documents (single-doc operations only)
    function isStudentDocOwner(studentId) {
      return isOwner(studentId) || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.firebaseUid == request.auth.uid
      );
    }

    // Verifies the target /students/{studentId} profile is explicitly a Teacher account (prevents Students from accessing teacher-only Lesson Planner subcollections)
    function isTeacherAccount(studentId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/students/$(studentId)) &&
             get(/databases/$(database)/documents/students/$(studentId)).data.get('accountRole', 'student') == 'teacher';
    }

    // Secure Parent-Child Link Verifier
    function isParentOf(studentId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
             (studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentIds);
    }

    // StudentProfile & Subscription Schema Validator (forbids passwordHash and privilege escalation fields)
    function isValidStudentProfile(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data) &&
             (!('accountRole' in data) || (data.accountRole in ['student', 'teacher'])) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
             (!('board' in data) || (data.board in ['Maharashtra', 'CBSE', 'ICSE'])) &&
             (!('primaryBoard' in data) || (data.primaryBoard in ['Maharashtra', 'CBSE', 'ICSE'])) &&
             (!('classLevel' in data) || (data.classLevel is string && data.classLevel.size() <= 20)) &&
             (!('medium' in data) || (data.medium in ['English', 'Marathi', 'Hindi', 'Semi-English'])) &&
             (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 100)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
             (!('parentLinkCode' in data) || (data.parentLinkCode is string && data.parentLinkCode.size() <= 32)) &&
             (!('teachingSubjects' in data) || (data.teachingSubjects is list && data.teachingSubjects.size() <= 30)) &&
             (!('classesTaught' in data) || (data.classesTaught is list && data.classesTaught.size() <= 12)) &&
             (!('plan' in data) || (data.plan in ['free', 'basic', 'premium'])) &&
             (!('selectedTeacherCategories' in data) || (data.selectedTeacherCategories is list && data.selectedTeacherCategories.size() <= 12));
    }

    // ParentProfile Schema Validator
    function isValidParentProfile(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             !('isAdmin' in data) &&
             !('role' in data) &&
             !('passwordHash' in data) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
             (!('relationship' in data) || (data.relationship in ['Mother', 'Father', 'Guardian'])) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
             (!('linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 20)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('registeredAt' in data) || (data.registeredAt is string && data.registeredAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // QuizAttempt Schema Validator
    function isValidQuizAttempt(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.correctCount is number && data.correctCount >= 0 &&
             data.correctCount <= data.totalQuestions;
    }

    // Assignment Submission Update Validator
    function isValidAssignmentUpdate(data) {
      return data.status is string && data.status.size() > 0 && data.status.size() <= 40 &&
             (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 50));
    }

    // PaymentTransaction Schema Validator
    function isValidTransaction(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.receiptNumber is string && data.receiptNumber.size() > 0 && data.receiptNumber.size() <= 50 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['SUCCESS', 'FAILED', 'PENDING', 'REFUNDED'];
    }

    // Announcement Schema Validator
    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 500;
    }

    // ReferralAccount Schema Validator
    function isValidReferralAccount(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 &&
             (!('availableWalletBalance' in data) || (data.availableWalletBalance is number && data.availableWalletBalance >= 0)) &&
             (!('totalEarnings' in data) || (data.totalEarnings is number && data.totalEarnings >= 0));
    }

    // Support Ticket & Grievance Validator
    function isValidSupportSubmission(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 2000;
    }

    // 1. Collection: /students/{studentId}
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isOwner(studentId) ||
        (isSignedIn() && (existing().id == request.auth.uid || existing().firebaseUid == request.auth.uid)) ||
        isParentOf(studentId) ||
        isAdmin()
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.id == request.auth.uid ||
          resource.data.firebaseUid == request.auth.uid ||
          (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email)
        )
      );
      allow create: if isValidId(studentId) && isValidStudentProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(studentId) &&
          incoming().id == studentId &&
          incoming().name is string &&
          incoming().email is string &&
          incoming().classLevel is string &&
          (!('plan' in incoming()) || incoming().plan == 'free') &&
          (!('activatedClasses' in incoming()) || incoming().activatedClasses.size() == 0) &&
          (!('activatedClassKeys' in incoming()) || incoming().activatedClassKeys.size() == 0) &&
          (!('classSubscriptions' in incoming()) || incoming().classSubscriptions.size() == 0) &&
          (!('activatedCategoryKeys' in incoming()) || incoming().activatedCategoryKeys.size() == 0) &&
          (!('categorySubscriptions' in incoming()) || incoming().categorySubscriptions.size() == 0) &&
          (!('primaryBoard' in incoming()) || incoming().primaryBoard == incoming().get('board', 'Maharashtra')) &&
          (!('primaryClassLevel' in incoming()) || incoming().primaryClassLevel == incoming().classLevel) &&
          (!('lastPaymentId' in incoming()) || incoming().lastPaymentId == null) &&
          (!('planExpiresAt' in incoming()) || incoming().planExpiresAt == null)
        )
      );
      allow update: if isValidId(studentId) && isValidStudentProfile(incoming()) && (
        isAdmin() ||
        (
          (isOwner(studentId) || (isSignedIn() && existing().firebaseUid == request.auth.uid)) &&
          incoming().id == existing().id &&
          (!('registeredAt' in existing()) || incoming().registeredAt == existing().registeredAt) &&
          incoming().get('accountRole', 'student') == existing().get('accountRole', 'student') &&
          (
            (
              incoming().get('classLevel', null) == existing().get('classLevel', null) &&
              incoming().get('board', 'Maharashtra') == existing().get('board', 'Maharashtra')
            ) ||
            (
              incoming().classLevel is string &&
              incoming().classLevel.size() <= 20 &&
              incoming().get('board', 'Maharashtra') in ['Maharashtra', 'CBSE', 'ICSE'] &&
              (
                (
                  incoming().get('board', 'Maharashtra') == existing().get('primaryBoard', existing().get('board', 'Maharashtra')) &&
                  incoming().classLevel == existing().get('primaryClassLevel', existing().get('classLevel', ''))
                ) ||
                'all_classes' in existing().get('activatedCategoryKeys', []) ||
                (incoming().get('board', 'Maharashtra') + '__' + incoming().classLevel) in existing().get('activatedClassKeys', []) ||
                (
                  incoming().get('board', 'Maharashtra') == 'Maharashtra' &&
                  incoming().classLevel in existing().get('activatedClasses', [])
                ) ||
                (
                  incoming().plan == 'premium' &&
                  incoming().get('lastPaymentId', '') is string &&
                  incoming().get('lastPaymentId', '').matches('^pay_[A-Za-z0-9]{8,40}$') &&
                  exists(/databases/$(database)/documents/transactions/$('tx_' + incoming().lastPaymentId))
                )
              )
            )
          ) &&
          (
            (
              incoming().plan == existing().plan &&
              incoming().get('primaryBoard', null) == existing().get('primaryBoard', null) &&
              incoming().get('primaryClassLevel', null) == existing().get('primaryClassLevel', null) &&
              incoming().get('subscriptionTier', null) == existing().get('subscriptionTier', null) &&
              incoming().get('activatedBoard', null) == existing().get('activatedBoard', null) &&
              incoming().get('activatedClassLevel', null) == existing().get('activatedClassLevel', null) &&
              incoming().get('activatedClasses', null) == existing().get('activatedClasses', null) &&
              incoming().get('activatedClassKeys', null) == existing().get('activatedClassKeys', null) &&
              incoming().get('classSubscriptions', null) == existing().get('classSubscriptions', null) &&
              incoming().get('activatedCategoryKeys', null) == existing().get('activatedCategoryKeys', null) &&
              incoming().get('categorySubscriptions', null) == existing().get('categorySubscriptions', null) &&
              incoming().get('planPurchasedAt', null) == existing().get('planPurchasedAt', null) &&
              incoming().get('planExpiresAt', null) == existing().get('planExpiresAt', null) &&
              incoming().get('lastPaymentId', null) == existing().get('lastPaymentId', null) &&
              incoming().get('lastOrderId', null) == existing().get('lastOrderId', null)
            ) ||
            (
              incoming().plan == 'premium' &&
              (!('activatedBoard' in incoming()) || incoming().activatedBoard in ['Maharashtra', 'CBSE', 'ICSE']) &&
              incoming().get('lastPaymentId', '') is string &&
              incoming().get('lastPaymentId', '').matches('^pay_[A-Za-z0-9]{8,40}$') &&
              incoming().get('lastOrderId', '') is string &&
              incoming().get('lastOrderId', '').matches('^(order|qr)_[A-Za-z0-9]{8,40}$') &&
              exists(/databases/$(database)/documents/transactions/$('tx_' + incoming().lastPaymentId))
            )
          )
        )
      );
      allow delete: if isAdmin();

      // Subcollection: /students/{studentId}/attempts/{attemptId}
      match /attempts/{attemptId} {
        allow get: if isValidId(studentId) && isValidId(attemptId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow list: if isValidId(studentId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow create: if isValidId(studentId) && isValidId(attemptId) &&
                         (isStudentDocOwner(studentId) || isAdmin()) &&
                         isValidQuizAttempt(incoming()) &&
                         incoming().studentId == studentId;
        allow update: if false; // Immutable exam records
        allow delete: if isAdmin();
      }

      // Subcollection: /students/{studentId}/attendance/{attendanceId}
      match /attendance/{attendanceId} {
        allow get: if isValidId(studentId) && isValidId(attendanceId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow list: if isValidId(studentId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow write: if isAdmin();
      }

      // Subcollection: /students/{studentId}/assignments/{assignmentId}
      match /assignments/{assignmentId} {
        allow get: if isValidId(studentId) && isValidId(assignmentId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow list: if isValidId(studentId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isValidId(studentId) && isValidId(assignmentId) &&
          isStudentDocOwner(studentId) &&
          isValidAssignmentUpdate(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'submissionData', 'submittedAt'])
        );
      }

      // Subcollection: /students/{studentId}/fees/{feeId}
      match /fees/{feeId} {
        allow get: if isValidId(studentId) && isValidId(feeId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow list: if isValidId(studentId) && (isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin());
        allow write: if isAdmin();
      }

      // Additive Subcollection: /students/{studentId}/school_calendars/{calendarId}
      // Strictly isolated per Teacher UID; Students are denied by isTeacherAccount(studentId).
      match /school_calendars/{calendarId} {
        allow get: if isValidId(studentId) && isValidId(calendarId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow list: if isValidId(studentId) && (
          isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid && isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow create: if isValidId(studentId) && isValidId(calendarId) &&
                         isValidSchoolCalendar(incoming()) &&
                         incoming().id == calendarId && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             isTeacherAccount(studentId) &&
                             incoming().teacherUid == request.auth.uid
                           )
                         );
        allow update: if isValidId(studentId) && isValidId(calendarId) &&
                         isValidSchoolCalendar(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().teacherUid == existing().teacherUid &&
                         incoming().board == existing().board &&
                         incoming().academicYear == existing().academicYear && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             isTeacherAccount(studentId) &&
                             incoming().teacherUid == request.auth.uid &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'schoolName', 'medium', 'startDate', 'reopeningDate', 'endDate',
                               'syllabusCompletionDeadline', 'workingDaysOfWeek', 'saturdayRule',
                               'holidays', 'vacations', 'examWindows', 'revisionWindows', 'updatedAt'
                             ])
                           )
                         );
        allow delete: if isValidId(studentId) && isValidId(calendarId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
      }

      // Additive Subcollection: /students/{studentId}/lesson_plans_state/{stateId}
      // Strictly isolated per Teacher UID; Students are denied by isTeacherAccount(studentId).
      match /lesson_plans_state/{stateId} {
        allow get: if isValidId(studentId) && isValidId(stateId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow list: if isValidId(studentId) && (
          isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid && isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow create: if isValidId(studentId) && isValidId(stateId) &&
                         isValidLessonPlanState(incoming()) &&
                         incoming().id == stateId && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             isTeacherAccount(studentId) &&
                             incoming().teacherUid == request.auth.uid
                           )
                         );
        allow update: if isValidId(studentId) && isValidId(stateId) &&
                         isValidLessonPlanState(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().teacherUid == existing().teacherUid &&
                         incoming().board == existing().board &&
                         incoming().classLevel == existing().classLevel &&
                         incoming().subject == existing().subject &&
                         incoming().academicYear == existing().academicYear && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             isTeacherAccount(studentId) &&
                             incoming().teacherUid == request.auth.uid &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'division', 'medium', 'periodsPerWeek', 'teachingDays',
                               'completedLessonDates', 'completedDateLocks', 'completedChapterIds',
                               'chapterWeightOverrides', 'outcomeStatuses', 'outcomeNotes',
                               'permittedEdits', 'privateRemarks', 'shiftAnchorDate', 'updatedAt'
                             ])
                           )
                         );
        allow delete: if isValidId(studentId) && isValidId(stateId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
      }

      // Additive Subcollection: /students/{studentId}/additional_progress/{chapterId}
      // Strictly isolated per student owner; Master Gate ensures parent /students/{studentId} exists.
      match /additional_progress/{chapterId} {
        allow get: if isValidId(studentId) && isValidId(chapterId) && (
          isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin()
        );
        allow list: if isValidId(studentId) && (
          isStudentDocOwner(studentId) || isParentOf(studentId) || isAdmin()
        );
        allow create: if isValidId(studentId) && isValidId(chapterId) &&
                         isSignedIn() &&
                         isValidAdditionalProgress(incoming()) &&
                         incoming().studentId == studentId &&
                         incoming().chapterId == chapterId &&
                         exists(/databases/$(database)/documents/students/$(studentId)) &&
                         (isAdmin() || isStudentDocOwner(studentId));
        allow update: if isValidId(studentId) && isValidId(chapterId) &&
                         isSignedIn() &&
                         isValidAdditionalProgress(incoming()) &&
                         incoming().studentId == existing().studentId &&
                         incoming().chapterId == existing().chapterId &&
                         incoming().subjectId == existing().subjectId &&
                         exists(/databases/$(database)/documents/students/$(studentId)) && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             incoming().bestQuizScore >= existing().bestQuizScore &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'classLevel', 'board', 'medium',
                               'notesCompleted', 'worksheetCompleted', 'quizCompleted',
                               'bestQuizScore', 'quizTotal', 'lastUpdatedAt'
                             ])
                           )
                         );
        allow delete: if isValidId(studentId) && isValidId(chapterId) && isAdmin();
      }

      // Additive Subcollection: /students/{studentId}/teacher_tools_saved/{artifactId}
      // Strictly isolated per Teacher UID; Students are denied by isTeacherAccount(studentId).
      match /teacher_tools_saved/{artifactId} {
        allow get: if isValidId(studentId) && isValidId(artifactId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow list: if isValidId(studentId) && (
          isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid && isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
        allow create: if isValidId(studentId) && isValidId(artifactId) &&
                         isSignedIn() &&
                         incoming().keys().hasAll(['id', 'teacherUid', 'toolId', 'toolTitle', 'board', 'classLevel', 'subject', 'topic', 'contentBody', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'teacherUid', 'toolId', 'toolTitle', 'board', 'classLevel', 'subject', 'topic', 'contentBody', 'createdAt']) &&
                         isValidId(incoming().id) &&
                         incoming().id == artifactId &&
                         incoming().toolId is string && incoming().toolId.size() > 0 && incoming().toolId.size() <= 20 &&
                         incoming().toolTitle is string && incoming().toolTitle.size() > 0 && incoming().toolTitle.size() <= 120 &&
                         incoming().board in ['Maharashtra', 'CBSE', 'ICSE'] &&
                         incoming().classLevel is string && incoming().classLevel.size() > 0 && incoming().classLevel.size() <= 20 &&
                         incoming().subject is string && incoming().subject.size() > 0 && incoming().subject.size() <= 100 &&
                         incoming().topic is string && incoming().topic.size() > 0 && incoming().topic.size() <= 160 &&
                         incoming().contentBody is string && incoming().contentBody.size() > 0 && incoming().contentBody.size() <= 8000 &&
                         incoming().createdAt is string && incoming().createdAt.size() > 0 && incoming().createdAt.size() <= 50 && (
                           isAdmin() || (
                             isStudentDocOwner(studentId) &&
                             isTeacherAccount(studentId) &&
                             incoming().teacherUid == request.auth.uid
                           )
                         );
        allow delete: if isValidId(studentId) && isValidId(artifactId) && (
          isAdmin() || (isStudentDocOwner(studentId) && isTeacherAccount(studentId))
        );
      }
    }

    // 2. Collection: /parents/{parentId}
    match /parents/{parentId} {
      allow get: if isValidId(parentId) && (isOwner(parentId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isValidId(parentId) && isValidParentProfile(incoming()) && (isAdmin() || isOwner(parentId));
      allow update: if isValidId(parentId) && isValidParentProfile(incoming()) && (isOwner(parentId) || isAdmin()) && incoming().id == existing().id;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isValidId(parentId) && (isOwner(parentId) || isAdmin());
        allow create: if isValidId(parentId) && isValidId(messageId) &&
                         (isOwner(parentId) || isAdmin()) &&
                         incoming().id == messageId &&
                         incoming().studentId is string && incoming().studentId.size() <= 128 &&
                         incoming().subject is string && incoming().subject.size() > 0 && incoming().subject.size() <= 160 &&
                         incoming().body is string && incoming().body.size() > 0 && incoming().body.size() <= 1500;
        allow delete: if isValidId(parentId) && isValidId(messageId) && (isOwner(parentId) || isAdmin());
      }
    }

    // 3. Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 4. Collection: /announcements/{announcementId}
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
    }

    // 5. Collection: /transactions/{transactionId}
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && (
        existing().studentId == request.auth.uid ||
        isStudentDocOwner(existing().studentId) ||
        isParentOf(existing().studentId) ||
        isAdmin()
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          isParentOf(resource.data.studentId)
        )
      );
      // Verified payment records can be written by Admin or by the authenticated student owner with a valid Razorpay paymentId + signature
      allow create: if isValidId(transactionId) && isValidTransaction(incoming()) && (
        isAdmin() ||
        (
          isStudentDocOwner(incoming().studentId) &&
          transactionId == ('tx_' + incoming().paymentId) &&
          incoming().paymentId is string &&
          incoming().paymentId.matches('^pay_[A-Za-z0-9]{8,40}$') &&
          incoming().orderId is string &&
          incoming().orderId.matches('^(order|qr)_[A-Za-z0-9]{8,40}$') &&
          incoming().signature is string &&
          incoming().signature.size() >= 16 &&
          incoming().amount in [99, 149, 229, 299, 499] &&
          incoming().status == 'SUCCESS'
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Collection: /referrals/{userId}
    match /referrals/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(userId) && isValidReferralAccount(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().userId == userId &&
          (!('availableWalletBalance' in incoming()) || incoming().availableWalletBalance == 0) &&
          (!('totalEarnings' in incoming()) || incoming().totalEarnings == 0)
        )
      );
      allow update: if isValidId(userId) && isValidReferralAccount(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().userId == existing().userId &&
          incoming().referralCode == existing().referralCode &&
          (!('availableWalletBalance' in existing()) || incoming().availableWalletBalance == existing().availableWalletBalance) &&
          (!('totalEarnings' in existing()) || incoming().totalEarnings == existing().totalEarnings)
        )
      );
      allow delete: if isAdmin();
    }

    // 7. Collection: /referral_transactions/{txId}
    match /referral_transactions/{txId} {
      allow get: if isValidId(txId) && (
        isAdmin() ||
        (isSignedIn() && (existing().referrerId == request.auth.uid || existing().buyerStudentId == request.auth.uid))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.referrerId == request.auth.uid || resource.data.buyerStudentId == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    // 8. Collection: /payout_requests/{payoutId}
    match /payout_requests/{payoutId} {
      allow get: if isValidId(payoutId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(payoutId) && isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().amount is number &&
        incoming().amount >= 50;
      allow update, delete: if isAdmin();
    }

    // 9. Collection: /support_tickets/{ticketId}
    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isValidId(ticketId) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        isValidSupportSubmission(incoming());
      allow update, delete: if isAdmin();
    }

    // 10. Collection: /grievances/{grievanceId}
    match /grievances/{grievanceId} {
      allow get: if isValidId(grievanceId) && (isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isValidId(grievanceId) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        isValidSupportSubmission(incoming());
      allow update, delete: if isAdmin();
    }

    // 11. Collection: /question_reports/{reportId}
    match /question_reports/{reportId} {
      allow get: if isValidId(reportId) && (isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isValidId(reportId) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        incoming().questionId is string && incoming().questionId.size() > 0 && incoming().questionId.size() <= 128;
      allow update, delete: if isAdmin();
    }

    // DeviceSession Schema Validator
    function isValidDeviceSession(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.activeSessionId is string && data.activeSessionId.size() >= 8 && data.activeSessionId.size() <= 128 &&
             data.deviceId is string && data.deviceId.size() >= 6 && data.deviceId.size() <= 128 &&
             data.hardwareSignature is string && data.hardwareSignature.size() >= 8 && data.hardwareSignature.size() <= 128 &&
             data.deviceSignature is string && data.deviceSignature.size() >= 8 && data.deviceSignature.size() <= 128 &&
             data.status in ['ACTIVE', 'TERMINATED', 'EXPIRED'] &&
             data.loginAt is string && data.loginAt.size() <= 50 &&
             data.expiresAtMs is number &&
             (!('previousSessionId' in data) || (data.previousSessionId is string && data.previousSessionId.size() <= 128)) &&
             (!('previousDeviceId' in data) || (data.previousDeviceId is string && data.previousDeviceId.size() <= 128)) &&
             (!('terminatedBy' in data) || (data.terminatedBy is string && data.terminatedBy.size() <= 40)) &&
             (!('terminatedAt' in data) || (data.terminatedAt is string && data.terminatedAt.size() <= 50)) &&
             (!('terminationReason' in data) || (data.terminationReason is string && data.terminationReason.size() <= 200)) &&
             (!('deviceName' in data) || (data.deviceName is string && data.deviceName.size() <= 120)) &&
             (!('browser' in data) || (data.browser is string && data.browser.size() <= 60)) &&
             (!('os' in data) || (data.os is string && data.os.size() <= 60)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 100)) &&
             (!('sessionVersion' in data) || (data.sessionVersion is number && data.sessionVersion >= 1));
    }

    // 12. Collection: /device_sessions/{userId}
    // Enforces single-device session authentication at the database layer:
    // - Each student account has only ONE active session at a time.
    // - When the student logs in on another device/browser, it automatically invalidates the previous session.
    // - Realtime onSnapshot listener alerts the previous device immediately.
    // - Admins can inspect and terminate any session.
    match /device_sessions/{userId} {
      allow get: if isValidId(userId) && (isStudentDocOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.firebaseUid == request.auth.uid));
      allow create: if isValidId(userId) && isValidDeviceSession(incoming()) && (
        isAdmin() || (
          (isOwner(userId) || (isSignedIn() && incoming().get('firebaseUid', '') == request.auth.uid)) &&
          incoming().userId == userId &&
          incoming().status == 'ACTIVE'
        )
      );
      allow update: if isValidId(userId) && isValidDeviceSession(incoming()) && (
        isAdmin() || (
          (isStudentDocOwner(userId) || (isSignedIn() && existing().get('firebaseUid', '') == request.auth.uid)) &&
          incoming().userId == existing().userId &&
          (
            // Case 1: Active session heartbeat or explicit logout release on the EXACT SAME authorized session + hardware
            (
              existing().status == 'ACTIVE' &&
              incoming().activeSessionId == existing().activeSessionId &&
              incoming().deviceId == existing().deviceId &&
              incoming().hardwareSignature == existing().hardwareSignature &&
              incoming().deviceSignature == existing().deviceSignature &&
              incoming().status in ['ACTIVE', 'TERMINATED']
            ) ||
            // Case 2: Re-acquiring when prior session was terminated/logged out or expired
            (
              (existing().status != 'ACTIVE' || existing().expiresAtMs <= request.time.toMillis()) &&
              incoming().status == 'ACTIVE'
            ) ||
            // Case 3: Safe browser close/reopen resume on the EXACT SAME physical device & browser
            (
              incoming().deviceId == existing().deviceId &&
              incoming().hardwareSignature == existing().hardwareSignature &&
              incoming().status == 'ACTIVE'
            ) ||
            // Case 4: Authenticated student logging in on another device or browser, superseding previous session
            (
              incoming().status == 'ACTIVE' &&
              (isStudentDocOwner(userId) || (isSignedIn() && incoming().get('firebaseUid', '') == request.auth.uid))
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    // PlatformConfig Schema Validator (Zero-PII global timers, visibility & study library cache version)
    function isValidPlatformConfig(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             (!('timers' in data) || data.timers is map) &&
             (!('sectionVisibility' in data) || data.sectionVisibility is map) &&
             (!('studyLibraryVersion' in data) || (data.studyLibraryVersion is number && data.studyLibraryVersion >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // SpecialContentItem Schema Validator (Zero-PII admin-managed Special Learning & Study Library records)
    function isValidSpecialContentItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.contentType in ['story', 'shivaji_story', 'scholarship_question', 'drawing_template', 'gk_question', 'learning_program', 'study_material_item'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.published is bool &&
             data.payload is map &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             (!('board' in data) || (data.board in ['Maharashtra', 'CBSE', 'ICSE'])) &&
             (!('classLevel' in data) || (data.classLevel is string && data.classLevel.size() <= 20)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 100)) &&
             (!('materialCategory' in data) || (data.materialCategory is string && data.materialCategory.size() <= 60)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // 13. Collection: /platform_config/{configId}
    match /platform_config/{configId} {
      allow get: if isValidId(configId) && (configId == 'main' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(configId) && isAdmin() && isValidPlatformConfig(incoming());
      allow delete: if isAdmin();
    }

    // 14. Collection: /special_content/{itemId}
    match /special_content/{itemId} {
      allow get: if isValidId(itemId) && (isAdmin() || existing().published == true);
      allow list: if isAdmin() || resource.data.published == true;
      allow create, update: if isValidId(itemId) && isAdmin() && isValidSpecialContentItem(incoming());
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // ADDITIVE LESSON PLANNER VALIDATORS & COLLECTIONS (Collections 15–16)
    // ------------------------------------------------------------------

    // Global Academic Calendar / Settings Schema Validator (Zero-PII)
    function isValidAcademicCalendar(data) {
      return data.keys().hasAll(['id', 'isPublicCalendar', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'isPublicCalendar', 'board', 'academicYear', 'startDate', 'reopeningDate',
               'endDate', 'syllabusCompletionDeadline', 'workingDaysOfWeek', 'saturdayRule',
               'holidays', 'vacations', 'examWindows', 'revisionWindows', 'textbookEdition',
               'defaultPeriodMinutes', 'syllabusRevisionTag', 'allowTeacherWeightCustomization',
               'allowTeacherCalendarCustomization', 'showCurriculumReviewNoticeToTeachers',
               'defaultMediumByBoard', 'version', 'updatedAt', 'updatedByUid'
             ]) &&
             isValidId(data.id) &&
             data.isPublicCalendar is bool && data.isPublicCalendar == true &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             (!('board' in data) || (data.board in ['Maharashtra', 'CBSE', 'ICSE'])) &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() == 10)) &&
             (!('reopeningDate' in data) || (data.reopeningDate is string && data.reopeningDate.size() == 10)) &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.size() == 10)) &&
             (!('syllabusCompletionDeadline' in data) || (data.syllabusCompletionDeadline is string && data.syllabusCompletionDeadline.size() == 10)) &&
             (!('workingDaysOfWeek' in data) || (data.workingDaysOfWeek is list && data.workingDaysOfWeek.size() >= 1 && data.workingDaysOfWeek.size() <= 6 && data.workingDaysOfWeek[0] is number)) &&
             (!('saturdayRule' in data) || (data.saturdayRule in ['off', 'half_day', 'full_day', 'second_fourth_off'])) &&
             (!('holidays' in data) || (data.holidays is list && data.holidays.size() <= 80 && (data.holidays.size() == 0 || data.holidays[0] is map))) &&
             (!('vacations' in data) || (data.vacations is list && data.vacations.size() <= 15 && (data.vacations.size() == 0 || data.vacations[0] is map))) &&
             (!('examWindows' in data) || (data.examWindows is list && data.examWindows.size() <= 15 && (data.examWindows.size() == 0 || data.examWindows[0] is map))) &&
             (!('revisionWindows' in data) || (data.revisionWindows is list && data.revisionWindows.size() <= 15 && (data.revisionWindows.size() == 0 || data.revisionWindows[0] is map))) &&
             (!('textbookEdition' in data) || (data.textbookEdition is string && data.textbookEdition.size() <= 160)) &&
             (!('defaultPeriodMinutes' in data) || (data.defaultPeriodMinutes is number && data.defaultPeriodMinutes >= 20 && data.defaultPeriodMinutes <= 90)) &&
             (!('syllabusRevisionTag' in data) || (data.syllabusRevisionTag is string && data.syllabusRevisionTag.size() <= 60)) &&
             (!('allowTeacherWeightCustomization' in data) || data.allowTeacherWeightCustomization is bool) &&
             (!('allowTeacherCalendarCustomization' in data) || data.allowTeacherCalendarCustomization is bool) &&
             (!('showCurriculumReviewNoticeToTeachers' in data) || data.showCurriculumReviewNoticeToTeachers is bool) &&
             (!('defaultMediumByBoard' in data) || data.defaultMediumByBoard is map) &&
             (!('version' in data) || (data.version is number && data.version >= 1)) &&
             (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128));
    }

    // Immutable Academic Year Archive Schema Validator (Zero-PII)
    function isValidAcademicYearArchive(data) {
      return data.keys().hasAll([
               'id', 'isArchivedSnapshot', 'board', 'academicYear',
               'calendarSnapshot', 'summaryStats', 'archivedAt', 'archivedByUid'
             ]) &&
             data.keys().hasOnly([
               'id', 'isArchivedSnapshot', 'board', 'academicYear',
               'calendarSnapshot', 'summaryStats', 'archivedAt', 'archivedByUid', 'archiveNote'
             ]) &&
             isValidId(data.id) &&
             data.isArchivedSnapshot is bool && data.isArchivedSnapshot == true &&
             data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
             data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
             data.calendarSnapshot is map &&
             data.summaryStats is map &&
             data.archivedAt is string && data.archivedAt.size() > 0 && data.archivedAt.size() <= 50 &&
             data.archivedByUid is string && data.archivedByUid.size() > 0 && data.archivedByUid.size() <= 128 &&
             (!('archiveNote' in data) || (data.archiveNote is string && data.archiveNote.size() <= 300)) &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data);
    }

    // Private Per-Teacher School Calendar Override Schema Validator
    function isValidSchoolCalendar(data) {
      return data.keys().hasAll([
               'id', 'teacherUid', 'board', 'academicYear', 'reopeningDate',
               'endDate', 'syllabusCompletionDeadline', 'saturdayRule', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'teacherUid', 'board', 'academicYear', 'schoolName', 'medium',
               'startDate', 'reopeningDate', 'endDate', 'syllabusCompletionDeadline',
               'workingDaysOfWeek', 'saturdayRule', 'holidays', 'vacations',
               'examWindows', 'revisionWindows', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.teacherUid is string && data.teacherUid.size() > 0 && data.teacherUid.size() <= 128 &&
             data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
             data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 150)) &&
             (!('medium' in data) || (data.medium in ['English', 'Marathi', 'Semi-English', 'Hindi'])) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() == 10)) &&
             data.reopeningDate is string && data.reopeningDate.size() == 10 &&
             data.endDate is string && data.endDate.size() == 10 &&
             data.syllabusCompletionDeadline is string && data.syllabusCompletionDeadline.size() == 10 &&
             (!('workingDaysOfWeek' in data) || (data.workingDaysOfWeek is list && data.workingDaysOfWeek.size() >= 1 && data.workingDaysOfWeek.size() <= 6 && data.workingDaysOfWeek[0] is number)) &&
             data.saturdayRule in ['off', 'half_day', 'full_day', 'second_fourth_off'] &&
             (!('holidays' in data) || (data.holidays is list && data.holidays.size() <= 80 && (data.holidays.size() == 0 || data.holidays[0] is map))) &&
             (!('vacations' in data) || (data.vacations is list && data.vacations.size() <= 15 && (data.vacations.size() == 0 || data.vacations[0] is map))) &&
             (!('examWindows' in data) || (data.examWindows is list && data.examWindows.size() <= 15 && (data.examWindows.size() == 0 || data.examWindows[0] is map))) &&
             (!('revisionWindows' in data) || (data.revisionWindows is list && data.revisionWindows.size() <= 15 && (data.revisionWindows.size() == 0 || data.revisionWindows[0] is map))) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('isAdmin' in data) &&
             !('role' in data) &&
             !('passwordHash' in data);
    }

    // Private Per-Teacher Lesson Plan Progress, Edits & Remarks Schema Validator
    function isValidLessonPlanState(data) {
      return data.keys().hasAll([
               'id', 'teacherUid', 'board', 'classLevel', 'subject',
               'academicYear', 'division', 'medium', 'periodsPerWeek', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'teacherUid', 'board', 'classLevel', 'subject', 'academicYear',
               'division', 'medium', 'periodsPerWeek', 'teachingDays',
               'completedLessonDates', 'completedDateLocks', 'completedChapterIds',
               'chapterWeightOverrides', 'outcomeStatuses', 'outcomeNotes',
               'permittedEdits', 'privateRemarks', 'shiftAnchorDate', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.teacherUid is string && data.teacherUid.size() > 0 && data.teacherUid.size() <= 128 &&
             data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
             data.classLevel is string && data.classLevel.size() > 0 && data.classLevel.size() <= 20 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
             data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
             data.division is string && data.division.size() > 0 && data.division.size() <= 30 &&
             data.medium in ['English', 'Marathi', 'Semi-English', 'Hindi'] &&
             data.periodsPerWeek is number && data.periodsPerWeek >= 1 && data.periodsPerWeek <= 6 &&
             (!('teachingDays' in data) || (data.teachingDays is list && data.teachingDays.size() >= 1 && data.teachingDays.size() <= 6 && data.teachingDays[0] is number)) &&
             (!('completedLessonDates' in data) || (data.completedLessonDates is list && data.completedLessonDates.size() <= 300 && (data.completedLessonDates.size() == 0 || data.completedLessonDates[0] is string))) &&
             (!('completedDateLocks' in data) || (data.completedDateLocks is map && data.completedDateLocks.size() <= 300)) &&
             (!('completedChapterIds' in data) || (data.completedChapterIds is list && data.completedChapterIds.size() <= 60 && (data.completedChapterIds.size() == 0 || data.completedChapterIds[0] is string))) &&
             (!('chapterWeightOverrides' in data) || (data.chapterWeightOverrides is map && data.chapterWeightOverrides.size() <= 60)) &&
             (!('outcomeStatuses' in data) || (data.outcomeStatuses is map && data.outcomeStatuses.size() <= 180)) &&
             (!('outcomeNotes' in data) || (data.outcomeNotes is map && data.outcomeNotes.size() <= 180)) &&
             (!('permittedEdits' in data) || (data.permittedEdits is map && data.permittedEdits.size() <= 300)) &&
             (!('privateRemarks' in data) || (data.privateRemarks is map && data.privateRemarks.size() <= 300)) &&
             (!('shiftAnchorDate' in data) || (data.shiftAnchorDate is string && data.shiftAnchorDate.size() <= 10)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('isAdmin' in data) &&
             !('role' in data) &&
             !('passwordHash' in data);
    }

    // 15. Additive Collection: /academic_calendars/{calendarId}
    // Restricted strictly to verified Admins (full CRUD) and authorised Teachers (get-only on canonical active docs).
    match /academic_calendars/{calendarId} {
      allow get: if isValidId(calendarId) && (
        isAdmin() || (isSignedIn() && isTeacherAccount(request.auth.uid) && calendarId in ['mh_active', 'cbse_active', 'icse_active', 'global_settings'])
      );
      allow list: if isAdmin();
      allow create: if isValidId(calendarId) &&
                       isAdmin() &&
                       isValidAcademicCalendar(incoming()) &&
                       incoming().id == calendarId;
      allow update: if isValidId(calendarId) &&
                       isAdmin() &&
                       isValidAcademicCalendar(incoming()) &&
                       incoming().id == existing().id &&
                       (!('board' in existing()) || incoming().board == existing().board);
      allow delete: if isValidId(calendarId) && isAdmin();
    }

    // 16. Additive Collection: /academic_year_archives/{archiveId}
    // Immutable historical academic-year rollover snapshots (Admin create only; update & delete permanently forbidden).
    // Read/list restricted strictly to verified Admins and authorised Teachers.
    match /academic_year_archives/{archiveId} {
      allow get: if isValidId(archiveId) && (
        isAdmin() || (isSignedIn() && isTeacherAccount(request.auth.uid) && existing().isArchivedSnapshot == true)
      );
      allow list: if isAdmin() || (isSignedIn() && isTeacherAccount(request.auth.uid) && resource.data.isArchivedSnapshot == true);
      allow create: if isValidId(archiveId) &&
                       isAdmin() &&
                       isValidAcademicYearArchive(incoming()) &&
                       incoming().id == archiveId;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // ADDITIVE ADDITIONAL CURRICULUM VALIDATORS & COLLECTIONS (17–19)
    // ------------------------------------------------------------------

    // Isolated Student Supplementary Progress Schema Validator (Zero-PII)
    function isValidAdditionalProgress(data) {
      return data.keys().hasAll([
               'studentId', 'chapterId', 'subjectId', 'classLevel', 'board', 'medium',
               'notesCompleted', 'worksheetCompleted', 'quizCompleted',
               'bestQuizScore', 'quizTotal', 'lastUpdatedAt'
             ]) &&
             data.keys().hasOnly([
               'studentId', 'chapterId', 'subjectId', 'classLevel', 'board', 'medium',
               'notesCompleted', 'worksheetCompleted', 'quizCompleted',
               'bestQuizScore', 'quizTotal', 'lastUpdatedAt'
             ]) &&
             isValidId(data.studentId) &&
             isValidId(data.chapterId) &&
             isValidId(data.subjectId) &&
             data.classLevel is string && data.classLevel.size() > 0 && data.classLevel.size() <= 20 &&
             data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
             data.medium in ['English', 'Marathi', 'Hindi', 'Semi-English'] &&
             data.notesCompleted is bool &&
             data.worksheetCompleted is bool &&
             data.quizCompleted is bool &&
             data.bestQuizScore is number && data.bestQuizScore >= 0 &&
             data.quizTotal is number && data.quizTotal >= 0 && data.quizTotal <= 100 &&
             data.bestQuizScore <= data.quizTotal &&
             data.lastUpdatedAt is string && data.lastUpdatedAt.size() > 0 && data.lastUpdatedAt.size() <= 50 &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    // Zero-PII Additional Subject Catalog Validator
    function isValidAdditionalSubject(data) {
      return data.keys().hasAll([
               'id', 'code', 'name', 'localizedNames', 'tagline', 'description',
               'applicableBoards', 'applicableMediums', 'classesCovered',
               'accentColor', 'isPublished', 'updatedByUid', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'code', 'name', 'localizedNames', 'tagline', 'description',
               'applicableBoards', 'applicableMediums', 'classesCovered',
               'accentColor', 'isPublished', 'isCustom',
               'mapsFromNonStandaloneSubject', 'updatedByUid', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 16 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.localizedNames is map && data.localizedNames.size() <= 5 &&
             data.tagline is string && data.tagline.size() <= 200 &&
             data.description is string && data.description.size() <= 600 &&
             data.applicableBoards is list && data.applicableBoards.size() >= 1 && data.applicableBoards.size() <= 3 && data.applicableBoards[0] is string &&
             data.applicableMediums is list && data.applicableMediums.size() >= 1 && data.applicableMediums.size() <= 4 && data.applicableMediums[0] is string &&
             data.classesCovered is list && data.classesCovered.size() >= 1 && data.classesCovered.size() <= 10 && data.classesCovered[0] is string &&
             data.accentColor is string && data.accentColor.size() > 0 && data.accentColor.size() <= 30 &&
             data.isPublished is bool &&
             (!('isCustom' in data) || data.isCustom is bool) &&
             (!('mapsFromNonStandaloneSubject' in data) || (data.mapsFromNonStandaloneSubject is string && data.mapsFromNonStandaloneSubject.size() <= 120)) &&
             isValidId(data.updatedByUid) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    // Zero-PII Additional Chapter Catalog Validator
    function isValidAdditionalChapter(data) {
      return data.keys().hasAll([
               'chapterId', 'subjectId', 'classLevel', 'classNumber', 'chapterNumber',
               'title', 'localizedTitles', 'applicableBoards', 'applicableMediums',
               'curriculumLabel', 'workflowStatus', 'updatedAt',
               'learningObjectives', 'materials', 'updatedByUid'
             ]) &&
             data.keys().hasOnly([
               'chapterId', 'subjectId', 'classLevel', 'classNumber', 'chapterNumber',
               'title', 'localizedTitles', 'applicableBoards', 'applicableMediums',
               'curriculumLabel', 'workflowStatus', 'reviewedBy', 'updatedAt',
               'learningObjectives', 'materials', 'isCustom', 'updatedByUid'
             ]) &&
             isValidId(data.chapterId) &&
             isValidId(data.subjectId) &&
             data.classLevel is string && data.classLevel.size() > 0 && data.classLevel.size() <= 20 &&
             data.classNumber is number && data.classNumber >= 1 && data.classNumber <= 10 &&
             data.chapterNumber is number && data.chapterNumber >= 1 && data.chapterNumber <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.localizedTitles is map && data.localizedTitles.size() <= 5 &&
             data.applicableBoards is list && data.applicableBoards.size() >= 1 && data.applicableBoards.size() <= 3 && data.applicableBoards[0] is string &&
             data.applicableMediums is list && data.applicableMediums.size() >= 1 && data.applicableMediums.size() <= 4 && data.applicableMediums[0] is string &&
             data.curriculumLabel == 'MY STUDYZONE ADDITIONAL CURRICULUM' &&
             data.workflowStatus in ['DRAFT', 'UNDER_REVIEW', 'APPROVED', 'PUBLISHED', 'UNPUBLISHED'] &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             data.learningObjectives is list && data.learningObjectives.size() >= 1 && data.learningObjectives.size() <= 20 && data.learningObjectives[0] is string &&
             data.materials is map && data.materials.size() >= 1 && data.materials.size() <= 12 &&
             (!('isCustom' in data) || data.isCustom is bool) &&
             isValidId(data.updatedByUid) &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    // Zero-PII Supplementary Teacher Assignment Validator
    function isValidAdditionalAssignment(data) {
      return data.keys().hasAll([
               'assignmentId', 'teacherId', 'teacherUid', 'teacherName',
               'board', 'classLevel', 'medium', 'division',
               'subjectId', 'chapterId', 'chapterTitle', 'dueDate',
               'teacherNote', 'assignedAt', 'status'
             ]) &&
             data.keys().hasOnly([
               'assignmentId', 'teacherId', 'teacherUid', 'teacherName',
               'board', 'classLevel', 'medium', 'division',
               'subjectId', 'chapterId', 'chapterTitle', 'dueDate',
               'teacherNote', 'assignedAt', 'updatedAt', 'status'
             ]) &&
             isValidId(data.assignmentId) &&
             isValidId(data.teacherId) &&
             isValidId(data.teacherUid) &&
             data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 100 &&
             data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
             data.classLevel is string && data.classLevel.size() > 0 && data.classLevel.size() <= 20 &&
             data.medium in ['English', 'Marathi', 'Hindi', 'Semi-English'] &&
             data.division is string && data.division.size() > 0 && data.division.size() <= 30 &&
             isValidId(data.subjectId) &&
             isValidId(data.chapterId) &&
             data.chapterTitle is string && data.chapterTitle.size() > 0 && data.chapterTitle.size() <= 200 &&
             data.dueDate is string && data.dueDate.size() > 0 && data.dueDate.size() <= 20 &&
             data.teacherNote is string && data.teacherNote.size() <= 500 &&
             data.assignedAt is string && data.assignedAt.size() > 0 && data.assignedAt.size() <= 50 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             data.status in ['ACTIVE', 'COMPLETED'] &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    // 17. Additive Collection: /additional_curriculum_subjects/{subjectId}
    match /additional_curriculum_subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (
        isAdmin() || (isSignedIn() && existing().isPublished == true)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.isPublished == true);
      allow create: if isValidId(subjectId) &&
                       isAdmin() &&
                       isValidAdditionalSubject(incoming()) &&
                       incoming().id == subjectId &&
                       incoming().updatedByUid == request.auth.uid;
      allow update: if isValidId(subjectId) &&
                       isAdmin() &&
                       isValidAdditionalSubject(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().updatedByUid == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'code', 'name', 'localizedNames', 'tagline', 'description',
                         'applicableBoards', 'applicableMediums', 'classesCovered',
                         'accentColor', 'isPublished', 'isCustom',
                         'mapsFromNonStandaloneSubject', 'updatedByUid', 'updatedAt'
                       ]);
      allow delete: if isValidId(subjectId) && isAdmin();
    }

    // 18. Additive Collection: /additional_curriculum_chapters/{chapterId}
    match /additional_curriculum_chapters/{chapterId} {
      allow get: if isValidId(chapterId) && (
        isAdmin() || (isSignedIn() && existing().workflowStatus == 'PUBLISHED')
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.workflowStatus == 'PUBLISHED');
      allow create: if isValidId(chapterId) &&
                       isAdmin() &&
                       isValidAdditionalChapter(incoming()) &&
                       incoming().chapterId == chapterId &&
                       incoming().updatedByUid == request.auth.uid;
      allow update: if isValidId(chapterId) &&
                       isAdmin() &&
                       isValidAdditionalChapter(incoming()) &&
                       incoming().chapterId == existing().chapterId &&
                       incoming().curriculumLabel == existing().curriculumLabel &&
                       incoming().updatedByUid == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'subjectId', 'classLevel', 'classNumber', 'chapterNumber',
                         'title', 'localizedTitles', 'applicableBoards', 'applicableMediums',
                         'workflowStatus', 'reviewedBy', 'updatedAt',
                         'learningObjectives', 'materials', 'isCustom', 'updatedByUid'
                       ]);
      allow delete: if isValidId(chapterId) && isAdmin();
    }

    // 19. Additive Collection: /additional_curriculum_assignments/{assignmentId}
    match /additional_curriculum_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && (
        isAdmin() || (
          isSignedIn() && (
            existing().teacherUid == request.auth.uid || (
              existing().status in ['ACTIVE', 'COMPLETED'] &&
              existing().board in ['Maharashtra', 'CBSE', 'ICSE']
            )
          )
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.teacherUid == request.auth.uid || (
            resource.data.status in ['ACTIVE', 'COMPLETED'] &&
            resource.data.board in ['Maharashtra', 'CBSE', 'ICSE'] &&
            resource.data.classLevel is string &&
            resource.data.classLevel.size() > 0 &&
            resource.data.classLevel.size() <= 20
          )
        )
      );
      allow create: if isValidId(assignmentId) &&
                       isSignedIn() &&
                       isValidAdditionalAssignment(incoming()) &&
                       incoming().assignmentId == assignmentId &&
                       incoming().teacherUid == request.auth.uid && (
                         isAdmin() || (
                           isStudentDocOwner(incoming().teacherId) &&
                           isTeacherAccount(incoming().teacherId)
                         )
                       );
      allow update: if isValidId(assignmentId) &&
                       isSignedIn() &&
                       isValidAdditionalAssignment(incoming()) &&
                       incoming().assignmentId == existing().assignmentId &&
                       incoming().teacherId == existing().teacherId &&
                       incoming().teacherUid == existing().teacherUid &&
                       incoming().assignedAt == existing().assignedAt && (
                         isAdmin() || (
                           existing().teacherUid == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isValidId(assignmentId) && (
        isAdmin() || (isSignedIn() && existing().teacherUid == request.auth.uid)
      );
    }

    // ------------------------------------------------------------------
    // ADDITIVE FIVE-ZONE ECOSYSTEM VALIDATORS & COLLECTIONS (Collections 20–23)
    // ------------------------------------------------------------------

    function isValidSkillEnrollment(data) {
      return data.keys().hasAll(['id', 'userId', 'studentName', 'programId', 'programTitle', 'enrolledAt', 'completedModuleIds', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'studentName', 'programId', 'programTitle', 'enrolledAt',
               'completedModuleIds', 'quizBestScore', 'quizTotal', 'projectSubmittedNote',
               'certificateIssuedAt', 'certificateCode', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100 &&
             isValidId(data.programId) &&
             data.programTitle is string && data.programTitle.size() > 0 && data.programTitle.size() <= 120 &&
             data.enrolledAt is string && data.enrolledAt.size() > 0 && data.enrolledAt.size() <= 50 &&
             data.completedModuleIds is list && data.completedModuleIds.size() <= 20 &&
             (!('quizBestScore' in data) || (data.quizBestScore is number && data.quizBestScore >= 0 && data.quizBestScore <= 100)) &&
             (!('quizTotal' in data) || (data.quizTotal is number && data.quizTotal >= 0 && data.quizTotal <= 100)) &&
             (!('projectSubmittedNote' in data) || (data.projectSubmittedNote is string && data.projectSubmittedNote.size() <= 1000)) &&
             (!('certificateIssuedAt' in data) || (data.certificateIssuedAt is string && data.certificateIssuedAt.size() <= 50)) &&
             (!('certificateCode' in data) || (data.certificateCode is string && data.certificateCode.size() <= 64)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('email' in data) &&
             !('mobile' in data) &&
             !('phone' in data) &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    function isValidCoachingInstitute(data) {
      return data.keys().hasAll(['id', 'ownerUserId', 'instituteName', 'instituteType', 'city', 'contactPhone', 'directorName', 'programIdsOffered', 'published', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'ownerUserId', 'instituteName', 'instituteType', 'city', 'address',
               'contactPhone', 'directorName', 'programIdsOffered', 'published',
               'verificationStatus', 'customCourses', 'trainers', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.ownerUserId) &&
             data.instituteName is string && data.instituteName.size() > 0 && data.instituteName.size() <= 150 &&
             data.instituteType in ['Abacus & Vedic Maths Centre', 'Coaching Class', 'Skill Academy', 'Multi-Program Institute'] &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 80 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             data.contactPhone is string && data.contactPhone.size() <= 20 &&
             data.directorName is string && data.directorName.size() > 0 && data.directorName.size() <= 100 &&
             data.programIdsOffered is list && data.programIdsOffered.size() <= 30 &&
             data.published is bool &&
             (!('verificationStatus' in data) || (data.verificationStatus in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'])) &&
             (!('customCourses' in data) || (data.customCourses is list && data.customCourses.size() <= 30)) &&
             (!('trainers' in data) || (data.trainers is list && data.trainers.size() <= 50)) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    function isValidCoachingBatch(data) {
      return data.keys().hasAll(['id', 'instituteId', 'batchName', 'programId', 'trainerName', 'schedule', 'studentIds', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'instituteId', 'batchName', 'programId', 'trainerName', 'schedule', 'studentIds', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.instituteId) &&
             data.batchName is string && data.batchName.size() > 0 && data.batchName.size() <= 120 &&
             isValidId(data.programId) &&
             data.trainerName is string && data.trainerName.size() > 0 && data.trainerName.size() <= 100 &&
             data.schedule is string && data.schedule.size() > 0 && data.schedule.size() <= 120 &&
             data.studentIds is list && data.studentIds.size() <= 200 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50;
    }

    function isValidCoachingStudentRoster(data) {
      return data.keys().hasAll(['id', 'instituteId', 'name', 'mobile', 'grade', 'programId', 'batchId', 'feeTotalInr', 'feePaidInr', 'attendancePresent', 'attendanceTotal', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'instituteId', 'name', 'mobile', 'grade', 'programId', 'batchId',
               'feeTotalInr', 'feePaidInr', 'attendancePresent', 'attendanceTotal',
               'latestAssessmentScore', 'parentNote', 'certificateCode', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.instituteId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.mobile is string && data.mobile.size() <= 20 &&
             data.grade is string && data.grade.size() > 0 && data.grade.size() <= 30 &&
             isValidId(data.programId) &&
             isValidId(data.batchId) &&
             data.feeTotalInr is number && data.feeTotalInr >= 0 &&
             data.feePaidInr is number && data.feePaidInr >= 0 &&
             data.attendancePresent is number && data.attendancePresent >= 0 &&
             data.attendanceTotal is number && data.attendanceTotal >= data.attendancePresent &&
             (!('latestAssessmentScore' in data) || (data.latestAssessmentScore is string && data.latestAssessmentScore.size() <= 40)) &&
             (!('parentNote' in data) || (data.parentNote is string && data.parentNote.size() <= 500)) &&
             (!('certificateCode' in data) || (data.certificateCode is string && data.certificateCode.size() <= 64)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50;
    }

    function isValidSchoolInstitution(data) {
      return data.keys().hasAll(['id', 'ownerUserId', 'institutionName', 'institutionType', 'affiliationOrUniversity', 'city', 'principalName', 'contactEmailOrPhone', 'departmentsOrClasses', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'ownerUserId', 'institutionName', 'institutionType', 'affiliationOrUniversity',
               'city', 'address', 'principalName', 'contactEmailOrPhone', 'departmentsOrClasses',
               'academicYear', 'classesCount', 'divisions', 'verificationStatus', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.ownerUserId) &&
             data.institutionName is string && data.institutionName.size() > 0 && data.institutionName.size() <= 160 &&
             data.institutionType in ['School (Std 1–10)', 'Higher Secondary / Jr College (Std 11–12)', 'Degree College / UG'] &&
             data.affiliationOrUniversity is string && data.affiliationOrUniversity.size() > 0 && data.affiliationOrUniversity.size() <= 150 &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 80 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             data.principalName is string && data.principalName.size() > 0 && data.principalName.size() <= 100 &&
             data.contactEmailOrPhone is string && data.contactEmailOrPhone.size() > 0 && data.contactEmailOrPhone.size() <= 150 &&
             data.departmentsOrClasses is list && data.departmentsOrClasses.size() <= 40 &&
             (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 20)) &&
             (!('classesCount' in data) || (data.classesCount is number && data.classesCount >= 1 && data.classesCount <= 100)) &&
             (!('divisions' in data) || (data.divisions is list && data.divisions.size() <= 60)) &&
             (!('verificationStatus' in data) || (data.verificationStatus in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'])) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50 &&
             !('passwordHash' in data) &&
             !('isAdmin' in data) &&
             !('role' in data);
    }

    function isValidInstitutionMember(data) {
      return data.keys().hasAll(['id', 'institutionId', 'role', 'fullName', 'rollOrCode', 'classOrDepartment', 'attendancePresent', 'attendanceTotal', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'institutionId', 'role', 'fullName', 'rollOrCode', 'classOrDepartment', 'attendancePresent', 'attendanceTotal', 'latestExamName', 'latestMarksPct', 'updatedAt']) &&
             isValidId(data.id) &&
             isValidId(data.institutionId) &&
             data.role in ['student', 'faculty'] &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.rollOrCode is string && data.rollOrCode.size() > 0 && data.rollOrCode.size() <= 40 &&
             data.classOrDepartment is string && data.classOrDepartment.size() > 0 && data.classOrDepartment.size() <= 80 &&
             data.attendancePresent is number && data.attendancePresent >= 0 &&
             data.attendanceTotal is number && data.attendanceTotal >= data.attendancePresent &&
             (!('latestExamName' in data) || (data.latestExamName is string && data.latestExamName.size() <= 100)) &&
             (!('latestMarksPct' in data) || (data.latestMarksPct is number && data.latestMarksPct >= 0 && data.latestMarksPct <= 100)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50;
    }

    function isValidInstitutionNotice(data) {
      return data.keys().hasAll(['id', 'institutionId', 'title', 'audience', 'body', 'publishedAt']) &&
             data.keys().hasOnly(['id', 'institutionId', 'title', 'audience', 'body', 'publishedAt']) &&
             isValidId(data.id) &&
             isValidId(data.institutionId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.audience in ['All Campus', 'Students Only', 'Faculty & Staff'] &&
             data.body is string && data.body.size() > 0 && data.body.size() <= 1500 &&
             data.publishedAt is string && data.publishedAt.size() > 0 && data.publishedAt.size() <= 50;
    }

    function isCoachingInstituteOwner(instituteId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/coaching_institutes/$(instituteId)) &&
             get(/databases/$(database)/documents/coaching_institutes/$(instituteId)).data.ownerUserId == request.auth.uid;
    }

    function isSchoolInstitutionOwner(institutionId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/institutions/$(institutionId)) &&
             get(/databases/$(database)/documents/institutions/$(institutionId)).data.ownerUserId == request.auth.uid;
    }

    // 20. Additive Collection: /skill_enrollments/{enrollmentId}
    match /skill_enrollments/{enrollmentId} {
      allow get: if isValidId(enrollmentId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(enrollmentId) &&
                       isSignedIn() &&
                       isValidSkillEnrollment(incoming()) &&
                       incoming().id == enrollmentId &&
                       (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isValidId(enrollmentId) &&
                       isSignedIn() &&
                       isValidSkillEnrollment(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().programId == existing().programId &&
                       incoming().enrolledAt == existing().enrolledAt && (
                         isAdmin() || (
                           existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'completedModuleIds', 'quizBestScore', 'quizTotal',
                             'projectSubmittedNote', 'certificateIssuedAt', 'certificateCode', 'updatedAt'
                           ])
                         )
                       );
      allow delete: if isValidId(enrollmentId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
    }

    // 21. Additive Collection: /coaching_institutes/{instituteId} (+ tenant-isolated batches & roster)
    match /coaching_institutes/{instituteId} {
      allow get: if isValidId(instituteId) && (
        isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isValidId(instituteId) &&
                       isSignedIn() &&
                       isValidCoachingInstitute(incoming()) &&
                       incoming().id == instituteId &&
                       (isAdmin() || incoming().ownerUserId == request.auth.uid);
      allow update: if isValidId(instituteId) &&
                       isSignedIn() &&
                       isValidCoachingInstitute(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerUserId == existing().ownerUserId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           existing().ownerUserId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'instituteName', 'instituteType', 'city', 'contactPhone',
                             'directorName', 'programIdsOffered', 'published', 'updatedAt'
                           ])
                         )
                       );
      allow delete: if isValidId(instituteId) && (
        isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid)
      );

      match /batches/{batchId} {
        allow get, list: if isValidId(instituteId) && (isAdmin() || isCoachingInstituteOwner(instituteId));
        allow create: if isValidId(instituteId) && isValidId(batchId) &&
                         isValidCoachingBatch(incoming()) &&
                         incoming().id == batchId &&
                         incoming().instituteId == instituteId &&
                         (isAdmin() || isCoachingInstituteOwner(instituteId));
        allow update: if isValidId(instituteId) && isValidId(batchId) &&
                         isValidCoachingBatch(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().instituteId == existing().instituteId &&
                         (isAdmin() || (
                           isCoachingInstituteOwner(instituteId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['batchName', 'programId', 'trainerName', 'schedule', 'studentIds', 'updatedAt'])
                         ));
        allow delete: if isValidId(instituteId) && isValidId(batchId) && (isAdmin() || isCoachingInstituteOwner(instituteId));
      }

      match /roster/{memberId} {
        allow get, list: if isValidId(instituteId) && (isAdmin() || isCoachingInstituteOwner(instituteId));
        allow create: if isValidId(instituteId) && isValidId(memberId) &&
                         isValidCoachingStudentRoster(incoming()) &&
                         incoming().id == memberId &&
                         incoming().instituteId == instituteId &&
                         (isAdmin() || isCoachingInstituteOwner(instituteId));
        allow update: if isValidId(instituteId) && isValidId(memberId) &&
                         isValidCoachingStudentRoster(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().instituteId == existing().instituteId &&
                         (isAdmin() || (
                           isCoachingInstituteOwner(instituteId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'mobile', 'grade', 'programId', 'batchId',
                             'feeTotalInr', 'feePaidInr', 'attendancePresent', 'attendanceTotal',
                             'latestAssessmentScore', 'parentNote', 'certificateCode', 'updatedAt'
                           ])
                         ));
        allow delete: if isValidId(instituteId) && isValidId(memberId) && (isAdmin() || isCoachingInstituteOwner(instituteId));
      }
    }

    // 22. Additive Collection: /institutions/{institutionId} (+ tenant-isolated members & notices)
    match /institutions/{institutionId} {
      allow get: if isValidId(institutionId) && (
        isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isValidId(institutionId) &&
                       isSignedIn() &&
                       isValidSchoolInstitution(incoming()) &&
                       incoming().id == institutionId &&
                       (isAdmin() || incoming().ownerUserId == request.auth.uid);
      allow update: if isValidId(institutionId) &&
                       isSignedIn() &&
                       isValidSchoolInstitution(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerUserId == existing().ownerUserId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() || (
                           existing().ownerUserId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'institutionName', 'institutionType', 'affiliationOrUniversity',
                             'city', 'principalName', 'contactEmailOrPhone',
                             'departmentsOrClasses', 'updatedAt'
                           ])
                         )
                       );
      allow delete: if isValidId(institutionId) && (
        isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid)
      );

      match /members/{memberId} {
        allow get, list: if isValidId(institutionId) && (isAdmin() || isSchoolInstitutionOwner(institutionId));
        allow create: if isValidId(institutionId) && isValidId(memberId) &&
                         isValidInstitutionMember(incoming()) &&
                         incoming().id == memberId &&
                         incoming().institutionId == institutionId &&
                         (isAdmin() || isSchoolInstitutionOwner(institutionId));
        allow update: if isValidId(institutionId) && isValidId(memberId) &&
                         isValidInstitutionMember(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().institutionId == existing().institutionId &&
                         (isAdmin() || (
                           isSchoolInstitutionOwner(institutionId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'role', 'fullName', 'rollOrCode', 'classOrDepartment',
                             'attendancePresent', 'attendanceTotal', 'latestExamName', 'latestMarksPct', 'updatedAt'
                           ])
                         ));
        allow delete: if isValidId(institutionId) && isValidId(memberId) && (isAdmin() || isSchoolInstitutionOwner(institutionId));
      }

      match /notices/{noticeId} {
        allow get, list: if isValidId(institutionId) && (isAdmin() || isSchoolInstitutionOwner(institutionId));
        allow create: if isValidId(institutionId) && isValidId(noticeId) &&
                         isValidInstitutionNotice(incoming()) &&
                         incoming().id == noticeId &&
                         incoming().institutionId == institutionId &&
                         (isAdmin() || isSchoolInstitutionOwner(institutionId));
        allow delete: if isValidId(institutionId) && isValidId(noticeId) && (isAdmin() || isSchoolInstitutionOwner(institutionId));
      }
    }

    // 23. Additive Collection: /five_zones_cms/{configId} (Zero-PII Central Governance)
    match /five_zones_cms/{configId} {
      allow get: if isValidId(configId) && (configId == 'main' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(configId) &&
                               isAdmin() &&
                               incoming().keys().hasAll(['id', 'zonesEnabled', 'pricingTierLabels', 'programPublishedMap', 'updatedAt', 'updatedByUid']) &&
                               incoming().keys().hasOnly(['id', 'zonesEnabled', 'pricingTierLabels', 'programPublishedMap', 'updatedAt', 'updatedByUid']) &&
                               incoming().id == configId &&
                               incoming().zonesEnabled is map &&
                               incoming().pricingTierLabels is map &&
                               incoming().programPublishedMap is map &&
                               incoming().updatedAt is string && incoming().updatedAt.size() <= 50 &&
                               incoming().updatedByUid == request.auth.uid &&
                               !('email' in incoming()) &&
                               !('mobile' in incoming()) &&
                               !('phone' in incoming()) &&
                               !('passwordHash' in incoming());
      allow delete: if isValidId(configId) && isAdmin();
    }

    // 24. Additive Collection: /portal_roles/{userId}
    // Maps Firebase Auth UIDs to strict 5-portal roles (never allows self-assigning 'admin' or self-verifying institutions)
    function isValidPortalRoleRecord(data) {
      return data.keys().hasAll(['id', 'role', 'displayName', 'email', 'mobile', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'role', 'displayName', 'email', 'mobile', 'city',
               'board', 'classLevel', 'medium', 'qualification', 'teachingSubjects',
               'classesTaught', 'relationship', 'institutionId', 'instituteId',
               'verificationStatus', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.role in ['student', 'teacher', 'parent', 'school_admin', 'institute_admin'] &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.mobile is string && data.mobile.size() <= 20 &&
             (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
             (!('board' in data) || (data.board in ['Maharashtra', 'CBSE', 'ICSE'])) &&
             (!('classLevel' in data) || (data.classLevel is string && data.classLevel.size() <= 20)) &&
             (!('medium' in data) || (data.medium in ['English', 'Marathi', 'Hindi', 'Semi-English'])) &&
             (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 100)) &&
             (!('teachingSubjects' in data) || (data.teachingSubjects is list && data.teachingSubjects.size() <= 30)) &&
             (!('classesTaught' in data) || (data.classesTaught is list && data.classesTaught.size() <= 12)) &&
             (!('relationship' in data) || (data.relationship in ['Mother', 'Father', 'Guardian'])) &&
             (!('institutionId' in data) || (data.institutionId is string && data.institutionId.size() <= 128)) &&
             (!('instituteId' in data) || (data.instituteId is string && data.instituteId.size() <= 128)) &&
             (!('verificationStatus' in data) || (data.verificationStatus in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'])) &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50 &&
             !('isAdmin' in data) &&
             !('passwordHash' in data);
    }

    match /portal_roles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isValidId(userId) &&
                       isValidPortalRoleRecord(incoming()) &&
                       incoming().id == userId && (
                         isAdmin() || (
                           isOwner(userId) &&
                           incoming().role != 'admin' &&
                           (!('verificationStatus' in incoming()) || incoming().verificationStatus == 'PENDING_VERIFICATION')
                         )
                       );
      allow update: if isValidId(userId) &&
                       isValidPortalRoleRecord(incoming()) &&
                       incoming().id == existing().id && (
                         isAdmin() || (
                           isOwner(userId) &&
                           incoming().role == existing().role &&
                           (!('verificationStatus' in existing()) || incoming().verificationStatus == existing().verificationStatus)
                         )
                       );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // SnapSolve AI Saved Documents Validator (strict schema + size limits; no large binary images)
    function isValidSnapSolveDocument(data) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'portalRole', 'title', 'subject',
               'answerLanguage', 'answerStyle', 'pageCount',
               'questions', 'solutions', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'portalRole', 'title', 'subject',
               'answerLanguage', 'answerStyle', 'pageCount',
               'questions', 'solutions', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             isValidId(data.ownerUid) &&
             data.portalRole in ['student', 'teacher'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 80 &&
             data.answerLanguage is string && data.answerLanguage.size() > 0 && data.answerLanguage.size() <= 80 &&
             data.answerStyle is string && data.answerStyle.size() > 0 && data.answerStyle.size() <= 40 &&
             data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 10 &&
             data.questions is list && data.questions.size() <= 60 &&
             data.solutions is list && data.solutions.size() <= 60 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             !('isAdmin' in data) &&
             !('passwordHash' in data);
    }

    match /snapsolve_documents/{docId} {
      allow get: if isValidId(docId) && (
        isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(docId) &&
                       isSignedIn() &&
                       isValidSnapSolveDocument(incoming()) &&
                       incoming().id == docId &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isValidId(docId) &&
                       isSignedIn() &&
                       isValidSnapSolveDocument(incoming()) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().id == existing().id &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().portalRole == existing().portalRole &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subject', 'answerLanguage', 'answerStyle',
                         'pageCount', 'questions', 'solutions', 'updatedAt'
                       ]);
      allow delete: if isValidId(docId) && (
        isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid)
      );
    }
  }
}
