        "city": { "type": "string", "maxLength": 80 },
        "parentLinkCode": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "name", "email", "classLevel"]
    },
    "ParentProfile": {
      "title": "ParentProfile",
